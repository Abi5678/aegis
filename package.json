{
  "name": "aegis-agent-immune-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --env-file-if-exists=.env.local --import tsx --watch apps/aegis/src/server/index.ts",
    "dev:web": "vite --config apps/aegis/vite.config.ts",
    "start": "node --env-file-if-exists=.env.local --import tsx apps/aegis/src/server/index.ts",
    "demo": "npm run build && npm start",
    "demo:fast": "npm run build && AEGIS_REPLAY_DURATION_MS=12000 npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/aegis/vite.config.ts",
    "verify": "npm test && npm run build",
    "asset:character": "blender --background --python tools/blender/create-aegis-character.py --"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@openai/codex-sdk": "latest",
    "esbuild": "^0.28.1",
    "fastify": "latest",
    "framer-motion": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
