# Replay mode needs no credentials.
# Live GPT-5.6 attack generation and diagnosis:
OPENAI_API_KEY=
# Optional model overrides
AEGIS_REASONING_MODEL=gpt-5.6
AEGIS_VOLUME_MODEL=gpt-5.6-terra
# Configure current model pricing explicitly for auditable live cost scoring.
AEGIS_TERRA_INPUT_USD_PER_MILLION=0
AEGIS_TERRA_OUTPUT_USD_PER_MILLION=0
# Optional: enable Codex candidate mutation in live mode
AEGIS_ENABLE_CODEX=false
# Required only for live run creation and live promotion. Enter the same value
# in the UI; it is kept in browser memory and never bundled.
AEGIS_LIVE_CONTROL_TOKEN=
# Optional exact cross-origin browser origin. Same-origin is the default.
AEGIS_ALLOWED_ORIGIN=
PORT=3000
HOST=127.0.0.1
